[org.gnome.desktop.interface:Budgie]
cursor-theme='Bibata-Modern-Classic'
document-font-name='Noto Sans 10'
font-name='Noto Sans 10'
gtk-theme='Graphite-blue-Dark-nord'
icon-theme='Tela-circle-blue-dark'
monospace-font-name='Monospace 10'

[com.solus-project.icon-tasklist]
pinned-launchers=['firefox.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop']

[com.solus-project.budgie-panel]
builtin-theme=false
dark-theme=true

[org.gnome.desktop.background:Budgie]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/catos.png'

[org.gnome.desktop.screensaver]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/catos.png'
