pkgname=catos-gtk-settings
pkgver=1.0
pkgrel=3
pkgdesc="Default GTK settings for CatOS"
arch=('any')
url='https://github.com/CatOS-dev/catos-gtk-settings'
license=('GPL')
depends=('catos-branding' 'catos-graphite-gtk-theme')
makedepends=('git')
source=('git+https://github.com/CatOS-dev/catos-gtk-settings.git')
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  if [[ -d etc ]]; then
    install -d "${pkgdir}/etc"
    cp -a etc/. "${pkgdir}/etc/"
  fi
}
