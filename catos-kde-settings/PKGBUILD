pkgname=catos-kde-settings
pkgver=2.1
pkgrel=1
pkgdesc="CatOS KDE Settings"
arch=('any')
url='https://github.com/CatOS-dev/catos-kde-settings'
license=('GPL')
makedepends=('git')
source=("git+https://github.com/CatOS-dev/catos-kde-settings.git")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname"

  if [[ -d etc ]]; then
    install -d "$pkgdir/etc"
    cp -a etc/. "$pkgdir/etc/"
  fi
  if [[ -d usr ]]; then
    install -d "$pkgdir/usr"
    cp -a usr/. "$pkgdir/usr/"
  fi
}
