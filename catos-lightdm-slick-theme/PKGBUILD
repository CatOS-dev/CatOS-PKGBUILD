pkgname=catos-lightdm-slick-theme
pkgver=3.2
pkgrel=4
pkgdesc='CatOS theme for lightdm-slick-greeter'
arch=('any')
url='https://catos.info'
license=('GPL3')
depends=('lightdm-slick-greeter' 'catos-branding')
optdepends=('catos-tela-icon-theme-blue: icon theme used by the greeter'
            'catos-bibata-cursor: cursor theme used by the greeter')
backup=('etc/lightdm/slick-greeter.conf'
        'etc/lightdm/lightdm.conf.d/10-catos-slick.conf')
source=('slick-greeter.conf' '10-catos-slick.conf')
sha512sums=('dd7b01258293b0196e47cca8dc0b46e5188b64ae8228a7ff4a0638053fe0a41a1ee99ba77a6161d65295c1ea34ef940f1eb2e349af6bdd8c833f64c23586fa2d'
            'bcab1b65a2b8719c5fe86bcca674c58501e4e1c4db7255b40c29b6cc5498164b581cab4538251d3a43a275bba2db056e8e845267105aa8bd063ae4077dd648ca')

package() {
  install -Dm644 "${srcdir}/slick-greeter.conf" \
    "${pkgdir}/etc/lightdm/slick-greeter.conf"
  install -Dm644 "${srcdir}/10-catos-slick.conf" \
    "${pkgdir}/etc/lightdm/lightdm.conf.d/10-catos-slick.conf"
}
