pkgname=catos-niri-dms
pkgver=1.1.0
pkgrel=1
pkgdesc="Complete CatOS Niri + DMS Profile"
arch=('any')
url="https://github.com/CatOS-dev/catos-niri-dms"
license=('MIT' 'GPL')
makedepends=('git')
depends=(
  'catdot'
  'niri'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-gnome'
  'dms-shell-niri>=1.5.1'
  'matugen'
  'cava'
  'cliphist'
  'cups-pk-helper'
  'i2c-tools'
  'power-profiles-daemon'
  'qt6-multimedia'
  'wtype'
  'ghostty'
  'xwayland-satellite'
  'catos-graphite-gtk-theme>=1.0-3'
  'tela-circle-icon-theme-all'
  'catos-bibata-cursor'
)
source=("git+https://github.com/CatOS-dev/catos-niri-dms.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/usr"
  cp -a usr/. "${pkgdir}/usr/"
  install -Dm644 LICENSE-DMS \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-DMS"
}
