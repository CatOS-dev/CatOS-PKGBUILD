pkgname=catos-niri-dms
pkgver=1.2.1
pkgrel=1
pkgdesc="Complete CatOS Niri + DMS Profile"
arch=('any')
url="https://github.com/CatOS-dev/catos-niri-dms"
license=('MIT' 'GPL')
makedepends=('git')
depends=(
  'catdot'
  'niri'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-gnome'
  'gnome-keyring'
  'dms-shell-niri>=1.5.3'
  'catos-niri-utils'
  'matugen'
  'adw-gtk-theme'
  'qt6ct-kde'
  'qt6-multimedia'
  'fuzzel'
  'satty'
  'wl-clipboard'
  'fcitx5'
  'btop'
  'cava'
  'cliphist'
  'cups-pk-helper'
  'i2c-tools'
  'power-profiles-daemon'
  'wtype'
  'ghostty'
  'xwayland-satellite'
  'tela-circle-icon-theme-all'
  'catos-bibata-cursor'
)
source=("git+https://github.com/CatOS-dev/catos-niri-dms.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/usr"
  cp -a usr/. "${pkgdir}/usr/"
  install -Dm644 LICENSE-DMS \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-DMS"
}
