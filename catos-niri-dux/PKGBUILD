pkgname=catos-niri-dux
pkgver=1.2.1
pkgrel=3
pkgdesc="Complete CatOS Niri + Dux Profile"
arch=('any')
url="https://github.com/CatOS-dev/catos-niri-dux"
license=('MIT' 'GPL')
makedepends=('git')
replaces=('catos-niri-dms')
depends=(
  'catdot'
  'niri'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-gnome'
  'gnome-keyring'
  'dux-shell'
  'catos-niri-utils'
  'matugen'
  'adw-gtk-theme'
  'qt6ct-kde'
  'qt6-multimedia'
  'fuzzel'
  'satty'
  'wl-clipboard'
  'fcitx5'
  'btop'
  'cava'
  'cliphist'
  'cups-pk-helper'
  'i2c-tools'
  'power-profiles-daemon'
  'wtype'
  'ghostty'
  'xwayland-satellite'
  'tela-circle-icon-theme-all'
  'catos-bibata-cursor'
)
source=("git+https://github.com/CatOS-dev/catos-niri-dux.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/usr"
  cp -a usr/. "${pkgdir}/usr/"
  install -Dm644 LICENSE-DMS \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-DMS"
}
