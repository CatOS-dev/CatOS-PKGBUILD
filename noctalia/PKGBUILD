pkgname=noctalia
pkgver=5.5.0
pkgrel=1
pkgdesc="A sleek, customizable desktop shell crafted for Wayland"
arch=('x86_64')
url="https://github.com/noctalia-dev/noctalia"
license=('MIT')
provides=("noctalia=$pkgver")
conflicts=('noctalia-git')

depends=(
    'bash'
    'cairo'
    'curl'
    'fontconfig'
    'freetype2'
    'gcc-libs'
    'glib2'
    'glibc'
    'harfbuzz'
    'hicolor-icon-theme'
    'libglvnd'
    'libical'
    'libjxl'
    'libqalculate'
    'libsecret'
    'libsndfile'
    'libsodium'
    'libwebp'
    'libxkbcommon'
    'libxml2'
    'librsvg'
    'md4c'
    'pam'
    'pango'
    'pipewire'
    'polkit'
    'sdbus-cpp'
    'tomlplusplus'
    'wayland'
    'wireplumber'
)
makedepends=(
    'meson'
    'ninja'
    'nlohmann-json'
    'pkgconf'
    'stb'
    'wayland-protocols'
)
optdepends=(
    'ddcutil: external monitor brightness control'
    'git: plugin sources and plugin updates'
    'gnome-keyring: Secret Service provider'
    'keepassxc: alternative Secret Service provider'
    'upower: battery and power-device information'
)

source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/noctalia-dev/noctalia/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=('f3fe8a1f1d4306280413e04f934400b787dba212d296d97dfd638bcb55c78262')

build() {
    arch-meson "noctalia-$pkgver" build \
        --buildtype=release \
        -Dtests=disabled \
        -Dnative_optimizations=false \
        -Djemalloc=disabled
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
    install -Dm644 "noctalia-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
