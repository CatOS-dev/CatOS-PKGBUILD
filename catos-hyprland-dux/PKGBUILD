pkgname=catos-hyprland-dux
pkgver=1.0
pkgrel=6
pkgdesc="CatOS Catdot Profile: Hyprland + Dux + Ghostty"
arch=('any')
url="https://www.catos.info/"
license=('MIT')
provides=('catos-dms-preset')
replaces=('catos-hyprland-dms')
depends=(
  'catdot'
  'dux-shell'
  'hyprland>=0.55'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-hyprland'
  'ghostty'
  'matugen'
)
source=(
  'profile.toml'
  'hyprland.lua'
  'hypr-colors.lua'
  'hypr-layout.lua'
  'hypr-binds.lua'
  'custom-input.lua'
  'custom-outputs.lua'
  'custom-cursor.lua'
  'custom-binds.lua'
  'custom-rules.lua'
  '90-dms.conf'
  'ghostty.conf'
  'ghostty-colors.conf'
  'hyprland-session.target'
  'catos-hyprland-dux-session'
  'catos-hyprland-dux.desktop'
  'LICENSE-DMS'
)
