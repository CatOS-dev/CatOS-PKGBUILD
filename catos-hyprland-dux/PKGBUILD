prepare() {
  sed -i 's/{{TERMINAL_COMMAND}}/ghostty/g' "$srcdir/hypr-binds.lua"
}

package() {
  local profile_id='catos-hyprland-dms'
  local content="$pkgdir/usr/share/$profile_id"

  install -Dm644 "$srcdir/profile.toml" \
    "$pkgdir/usr/share/catdot/profiles/$profile_id/profile.toml"

  install -Dm644 "$srcdir/hyprland.lua" "$content/.config/hypr/hyprland.lua"
  install -Dm644 "$srcdir/hypr-colors.lua" "$content/.config/hypr/dms/colors.lua"
  install -Dm644 "$srcdir/hypr-layout.lua" "$content/.config/hypr/dms/layout.lua"
  install -Dm644 "$srcdir/hypr-binds.lua" "$content/.config/hypr/dms/binds.lua"

  install -Dm644 "$srcdir/custom-input.lua" \
    "$content/.config/hypr/custom/$profile_id/input.lua"
  install -Dm644 "$srcdir/custom-outputs.lua" \
    "$content/.config/hypr/custom/$profile_id/outputs.lua"
  install -Dm644 "$srcdir/custom-cursor.lua" \
    "$content/.config/hypr/custom/$profile_id/cursor.lua"
  install -Dm644 "$srcdir/custom-binds.lua" \
    "$content/.config/hypr/custom/$profile_id/binds.lua"
  install -Dm644 "$srcdir/custom-rules.lua" \
    "$content/.config/hypr/custom/$profile_id/rules.lua"

  install -Dm644 "$srcdir/90-dms.conf" "$content/.config/environment.d/90-dms.conf"
  install -Dm644 "$srcdir/ghostty.conf" "$content/.config/ghostty/config"
  install -Dm644 "$srcdir/ghostty-colors.conf" \
    "$content/.config/ghostty/themes/dankcolors"
  install -Dm644 "$srcdir/hyprland-session.target" \
    "$pkgdir/usr/lib/systemd/user/hyprland-session.target"
  install -d "$pkgdir/usr/lib/systemd/user/hyprland-session.target.wants"
  ln -s ../dms.service \
    "$pkgdir/usr/lib/systemd/user/hyprland-session.target.wants/dms.service"

  install -Dm755 "$srcdir/catos-hyprland-dux-session" \
    "$pkgdir/usr/bin/catos-hyprland-dux-session"
  install -Dm644 "$srcdir/catos-hyprland-dux.desktop" \
    "$pkgdir/usr/share/wayland-sessions/catos-hyprland-dux.desktop"
  install -Dm644 "$srcdir/LICENSE-DMS" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-DMS"
}
