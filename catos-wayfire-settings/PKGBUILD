pkgname=catos-wayfire-settings
pkgver=1.0.0
pkgrel=5
pkgdesc="CatOS ready-to-use Wayfire session preset"
arch=('any')
url='https://github.com/CatOS-dev/catos-wayfire-settings'
license=('GPL-3.0-or-later')
depends=(
  'wayfire'
  'wf-shell'
  'wcm'
  'catos-branding'
  'fuzzel'
  'foot'
  'swayidle'
  'swaylock'
  'wlopm'
  'polkit-gnome'
  'xdg-desktop-portal-wlr'
  'xdg-desktop-portal-gtk'
  'dbus'
)
optdepends=(
  'thunar: default file manager shortcut'
  'grim: screenshot capture'
  'slurp: interactive screenshot region selection'
  'swappy: screenshot annotation'
  'wl-clipboard: Wayland clipboard tools'
  'brightnessctl: hardware brightness shortcuts'
  'playerctl: media key support'
  'wireplumber: wpctl audio shortcuts'
  'network-manager-applet: network tray applet and connection editor'
  'blueman: Bluetooth tray applet and manager'
  'pavucontrol: graphical audio mixer'
  'xorg-xwayland: X11 application support'
  'xdg-user-dirs: standard user directory discovery'
  'catos-gtk-settings: CatOS GTK appearance'
  'catos-bibata-cursor: CatOS cursor theme'
  'catos-tela-icon-theme-blue: CatOS icon theme'
)
makedepends=('git')
source=("git+https://github.com/CatOS-dev/catos-wayfire-settings.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/etc" "${pkgdir}/usr"
  cp -a etc/. "${pkgdir}/etc/"
  cp -a usr/. "${pkgdir}/usr/"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
