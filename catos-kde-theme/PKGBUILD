pkgname=catos-kde-theme
pkgver=1.0
pkgrel=7
pkgdesc="CatOS KDE theme"
arch=('any')
url='https://github.com/CatOS-dev/catos-kde-theme'
license=('GPL')
depends=('catos-branding')
makedepends=('git')
source=('git+https://github.com/CatOS-dev/catos-kde-theme.git')
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  if [[ -d usr ]]; then
    install -d "${pkgdir}/usr"
    cp -a usr/. "${pkgdir}/usr/"
  fi
}
