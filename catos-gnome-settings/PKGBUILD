pkgname=catos-gnome-settings
pkgver=2.0
pkgrel=8
pkgdesc="CatOS GNOME settings"
arch=('any')
url='https://github.com/CatOS-dev/catos-gnome-settings'
license=('GPL')
depends=('catos-branding')
makedepends=('git')
source=('git+https://github.com/CatOS-dev/catos-gnome-settings.git')
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  if [[ -d etc ]]; then
    install -d "${pkgdir}/etc"
    cp -a etc/. "${pkgdir}/etc/"
  fi
  if [[ -d usr ]]; then
    install -d "${pkgdir}/usr"
    cp -a usr/. "${pkgdir}/usr/"
  fi
}
