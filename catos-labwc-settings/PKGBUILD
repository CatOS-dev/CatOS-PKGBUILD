pkgname=catos-labwc-settings
pkgver=1.0.0
pkgrel=7
pkgdesc="CatOS ready-to-use Labwc session preset"
arch=('any')
url='https://github.com/CatOS-dev/catos-labwc-settings'
license=('GPL-3.0-or-later')
depends=(
  'catdot'
  'labwc'
  'swaybg'
  'catos-waybar-settings'
  'catos-branding'
  'tela-circle-icon-theme-blue'
  'mako'
  'fuzzel'
  'foot'
  'swayidle'
  'swaylock'
  'wlopm'
  'polkit-gnome'
  'xdg-desktop-portal-wlr'
  'xdg-desktop-portal-gtk'
  'dbus'
)
optdepends=(
  'wdisplays: graphical output configuration'
  'thunar: default file manager shortcut'
  'grim: screenshot capture'
  'slurp: interactive screenshot region selection'
  'swappy: screenshot annotation'
  'wl-clipboard: Wayland clipboard tools'
  'brightnessctl: hardware brightness shortcuts'
  'playerctl: media key support'
  'wireplumber: wpctl audio shortcuts and Waybar audio status'
  'network-manager-applet: network tray applet and connection editor'
  'blueman: Bluetooth tray applet and manager'
  'pavucontrol: graphical audio mixer'
  'xorg-xwayland: X11 application support'
  'xdg-user-dirs: standard user directory discovery'
  'catos-gtk-settings: CatOS GTK appearance'
  'catos-bibata-cursor: CatOS cursor theme'
)
makedepends=('git')
source=("git+https://github.com/CatOS-dev/catos-labwc-settings.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/usr"
  cp -a usr/. "${pkgdir}/usr/"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
