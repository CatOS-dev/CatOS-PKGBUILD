pkgname=ckbcomp
pkgver=1.249
pkgrel=1
pkgdesc="Compile an XKB keyboard description to a keymap suitable for loadkeys or kbdcontrol"
arch=('any')
url='https://salsa.debian.org/installer-team/console-setup'
license=('GPL-2.0-or-later')
depends=('perl')
_pkgsrc="console-setup-${pkgver}"
source=("${_pkgsrc}.tar.gz::${url}/-/archive/${pkgver}/${_pkgsrc}.tar.gz")
sha256sums=('15570cf19f6251da4c7e0a25745da7b8a7ab27092484ba166039d5da2b06c093')

package() {
  cd "${_pkgsrc}"
  install -Dm755 Keyboard/ckbcomp -t "${pkgdir}/usr/bin/"
}
