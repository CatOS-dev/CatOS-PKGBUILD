[org.mate.caja.desktop]
font='Noto Sans 10'

[org.mate.panel]
default-layout='catos'

[org.mate.background]
picture-filename='/usr/share/backgrounds/catos/catos-light.png'
picture-options='zoom'

[org.mate.interface]
gtk-color-scheme='menu_bg: #383c4a'
gtk-theme='Graphite-blue-Dark-nord'
icon-theme='Tela-circle-blue-dark'
document-font-name='Noto Sans 10'
font-name='Noto Sans 10'
monospace-font-name='Monospace 10'

[org.mate.peripherals-mouse]
cursor-theme='Bibata-Modern-Classic'

[org.mate.Marco.general]
theme='Graphite-blue-Dark-nord'
titlebar-font='Noto Sans Bold 10'

[org.mate.NotificationDaemon]
popup-location='top_right'
theme='coco'
