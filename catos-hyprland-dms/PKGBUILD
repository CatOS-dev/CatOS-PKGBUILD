pkgname=catos-hyprland-dms
pkgver=1.0
pkgrel=3
pkgdesc="CatOS preset: Hyprland + DMS + Ghostty"
arch=('any')
url="https://www.catos.info/"
license=('MIT')
provides=('catos-dms-preset')
conflicts=('catos-niri-dms')
depends=(
  'dms-shell-hyprland>=1.5.1'
  'hyprland>=0.55'
  'ghostty'
  'matugen'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-hyprland'
)
source=(
  '90-dms.conf'
  'hyprland.lua'
  'hypr-colors.lua'
  'hypr-layout.lua'
  'hypr-binds.lua'
  'hypr-binds-user.lua'
  'hypr-outputs.lua'
  'hypr-cursor.lua'
  'hypr-windowrules.lua'
  'ghostty.conf'
  'ghostty-colors.conf'
  'hyprland-session.target'
  'catos-hyprland-dms-session'
  'catos-hyprland-dms.desktop'
  'LICENSE-DMS'
)
