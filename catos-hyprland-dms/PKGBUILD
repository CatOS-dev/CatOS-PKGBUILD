prepare() {
  sed -i 's/{{TERMINAL_COMMAND}}/ghostty/g' "$srcdir/hypr-binds.lua"
}

check() {
  local test_home="$srcdir/check-home"
  rm -rf "$test_home"
  install -d -m755 "$test_home/.config/hypr/dms"
  install -Dm644 "$srcdir/hyprland.lua" "$test_home/.config/hypr/hyprland.lua"
  install -Dm644 "$srcdir/hypr-colors.lua" "$test_home/.config/hypr/dms/colors.lua"
  install -Dm644 "$srcdir/hypr-layout.lua" "$test_home/.config/hypr/dms/layout.lua"
  install -Dm644 "$srcdir/hypr-binds.lua" "$test_home/.config/hypr/dms/binds.lua"
  install -Dm644 "$srcdir/hypr-binds-user.lua" "$test_home/.config/hypr/dms/binds-user.lua"
  install -Dm644 "$srcdir/hypr-outputs.lua" "$test_home/.config/hypr/dms/outputs.lua"
  install -Dm644 "$srcdir/hypr-cursor.lua" "$test_home/.config/hypr/dms/cursor.lua"
  install -Dm644 "$srcdir/hypr-windowrules.lua" "$test_home/.config/hypr/dms/windowrules.lua"

  HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config" \
    Hyprland --verify-config --config "$test_home/.config/hypr/hyprland.lua"
}

package() {
  install -d -m755 "$pkgdir/etc/skel/.config/environment.d"
  install -d -m755 "$pkgdir/etc/skel/.config/hypr/dms"
  install -d -m755 "$pkgdir/etc/skel/.config/ghostty/themes"
  install -d -m755 "$pkgdir/etc/skel/.config/systemd/user/hyprland-session.target.wants"

  install -Dm644 "$srcdir/90-dms.conf" "$pkgdir/etc/skel/.config/environment.d/90-dms.conf"
  install -Dm644 "$srcdir/hyprland.lua" "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
  install -Dm644 "$srcdir/hypr-colors.lua" "$pkgdir/etc/skel/.config/hypr/dms/colors.lua"
  install -Dm644 "$srcdir/hypr-layout.lua" "$pkgdir/etc/skel/.config/hypr/dms/layout.lua"
  install -Dm644 "$srcdir/hypr-binds.lua" "$pkgdir/etc/skel/.config/hypr/dms/binds.lua"
  install -Dm644 "$srcdir/hypr-binds-user.lua" "$pkgdir/etc/skel/.config/hypr/dms/binds-user.lua"
  install -Dm644 "$srcdir/hypr-outputs.lua" "$pkgdir/etc/skel/.config/hypr/dms/outputs.lua"
  install -Dm644 "$srcdir/hypr-cursor.lua" "$pkgdir/etc/skel/.config/hypr/dms/cursor.lua"
  install -Dm644 "$srcdir/hypr-windowrules.lua" "$pkgdir/etc/skel/.config/hypr/dms/windowrules.lua"
  install -Dm644 "$srcdir/ghostty.conf" "$pkgdir/etc/skel/.config/ghostty/config"
  install -Dm644 "$srcdir/ghostty-colors.conf" "$pkgdir/etc/skel/.config/ghostty/themes/dankcolors"
  install -Dm644 "$srcdir/hyprland-session.target" "$pkgdir/etc/skel/.config/systemd/user/hyprland-session.target"
  ln -s '/usr/lib/systemd/user/dms.service' \
    "$pkgdir/etc/skel/.config/systemd/user/hyprland-session.target.wants/dms.service"

  install -Dm755 "$srcdir/catos-hyprland-dms-session" "$pkgdir/usr/bin/catos-hyprland-dms-session"
  install -Dm644 "$srcdir/LICENSE-DMS" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-DMS"
  install -Dm644 "$srcdir/catos-hyprland-dms.desktop" \
    "$pkgdir/usr/share/wayland-sessions/catos-hyprland-dms.desktop"
}
