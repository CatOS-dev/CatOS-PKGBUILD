pkgname=catos-zsh-config
pkgver=1.0
pkgrel=2
pkgdesc="Zsh configuration for CatOS"
arch=('any')
url="https://github.com/CatOS-dev/catos-zsh-config"
license=('GPL-3.0-or-later')
makedepends=('git')
depends=(
  'bat'
  'expac'
  'eza'
  'fastfetch'
  'libnotify'
  'pkgfile'
  'catos-starship-config'
  'zoxide'
  'zsh'
  'zsh-autosuggestions'
  'zsh-completions'
  'zsh-history-substring-search'
  'zsh-syntax-highlighting'
)
optdepends=(
  'direnv: per-directory environment integration'
  'hwinfo: hardware summary alias'
  'jq: focused-window detection under Sway'
  'openbsd-netcat: termbin alias'
  'xorg-xprop: focused-window detection under X11'
)
source=("git+https://github.com/CatOS-dev/catos-zsh-config.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"
  install -d "${pkgdir}/etc" "${pkgdir}/usr"
  cp -a etc/. "${pkgdir}/etc/"
  cp -a usr/. "${pkgdir}/usr/"
}
