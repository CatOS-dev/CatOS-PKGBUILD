pkgname=catos-waybar-settings
pkgver=1.0.0
pkgrel=3
pkgdesc="Shared compositor-aware Waybar profiles for CatOS"
arch=('any')
url='https://github.com/CatOS-dev/catos-waybar-settings'
license=('GPL-3.0-or-later')
depends=(
  'waybar'
  'fuzzel'
  'ttf-jetbrains-mono-nerd'
  'procps-ng'
  'systemd'
)
optdepends=(
  'foot: default terminal used by the launcher shortcut'
  'network-manager-applet: graphical network connection editor'
  'blueman: graphical Bluetooth manager'
  'pavucontrol: graphical audio mixer'
  'wireplumber: PipeWire session manager and audio status'
)
makedepends=('git')
source=("git+https://github.com/CatOS-dev/catos-waybar-settings.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  install -d "${pkgdir}/usr"
  cp -a usr/. "${pkgdir}/usr/"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
