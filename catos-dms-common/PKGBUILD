pkgname=catos-dms-common
pkgver=1.0
pkgrel=1
pkgdesc="Shared CatOS defaults for DMS sessions"
arch=('any')
url="https://www.catos.info/"
license=('MIT')
depends=(
  'ghostty'
  'matugen'
)
backup=(
  'etc/skel/.config/environment.d/90-dms.conf'
  'etc/skel/.config/ghostty/config'
  'etc/skel/.config/ghostty/themes/dankcolors'
)
source=(
  '90-dms.conf'
  'ghostty.conf'
  'ghostty-colors.conf'
  'LICENSE-DMS'
)
sha256sums=('dde57e33ad9d9c713440b2f0411c0c42a09ed46c2ee549c4f91627dc374a5661'
            'b069a527d4529a6021354ffdb2da420349995a11f68a4264f70df3ae52d28ff5'
            '67a2587d2bf6f564f1b6f7889d4579ea8a7d9e73ed61654e935af3ef75180399'
            '4cee96286c5b7da9763a4694868bb1853b33bb1558821e0c609ad2eabd426bfa')

package() {
  install -Dm644 "$srcdir/90-dms.conf" \
    "$pkgdir/etc/skel/.config/environment.d/90-dms.conf"
  install -Dm644 "$srcdir/ghostty.conf" \
    "$pkgdir/etc/skel/.config/ghostty/config"
  install -Dm644 "$srcdir/ghostty-colors.conf" \
    "$pkgdir/etc/skel/.config/ghostty/themes/dankcolors"
  install -Dm644 "$srcdir/LICENSE-DMS" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-DMS"
}
