# Maintainer: CatOS

pkgname=catos-tela-icon-theme-blue
pkgver=2026.07.07
pkgrel=1
pkgdesc="Blue color variants of the Tela icon theme"
arch=('any')
url="https://github.com/vinceliuice/Tela-icon-theme"
license=('GPL-3.0-or-later')
depends=(
  'gtk-update-icon-cache'
  'hicolor-icon-theme'
)
provides=('tela-icon-theme-blue')
conflicts=(
  'tela-icon-theme'
  'tela-icon-theme-git'
)
options=('!strip')
_tag="${pkgver//./-}"
source=("Tela-icon-theme-${_tag}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('6b8c28f637067a15551459ab90e6720c5aba1215b777b6f1f506fea188a1ddf9')

prepare() {
  cd "Tela-icon-theme-${_tag}"

  # Icon caches are generated by the package manager after installation.
  sed -i '/gtk-update-icon-cache/d' install.sh
}

package() {
  cd "Tela-icon-theme-${_tag}"

  install -d "$pkgdir/usr/share/icons"
  ./install.sh blue -d "$pkgdir/usr/share/icons"
}
