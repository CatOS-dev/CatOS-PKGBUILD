pkgname=catos-fish-config
pkgver=3.0
pkgrel=2
pkgdesc="Fish configuration for CatOS"
arch=('any')
url="https://github.com/CatOS-dev/catos-fish-config"
license=('GPL-3.0-or-later' 'MIT')
makedepends=('git')
depends=(
  'bat'
  'expac'
  'eza'
  'fastfetch'
  'fish'
  'fisher'
  'fzf'
  'libnotify'
  'pkgfile'
  'catos-starship-config'
  'tealdeer'
  'zoxide'
)
optdepends=(
  'direnv: per-directory environment integration'
  'hwinfo: hardware summary alias'
  'jq: focused-window detection under Sway and Kitty'
  'openbsd-netcat: termbin alias'
)
source=("git+https://github.com/CatOS-dev/catos-fish-config.git")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"
  install -d "${pkgdir}/etc" "${pkgdir}/usr"
  cp -a etc/. "${pkgdir}/etc/"
  cp -a usr/. "${pkgdir}/usr/"
}
