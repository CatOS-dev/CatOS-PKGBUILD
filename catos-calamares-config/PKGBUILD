pkgname=catos-calamares-config
pkgver=26.07
pkgrel=12
pkgdesc="Calamares configuration for CatOS"
arch=('any')
url='https://github.com/CatOS-dev/catos-calamares-config'
license=('GPL3')
depends=('catos-branding' 'catos-calamares' 'python-yaml')
makedepends=('git')
conflicts=('alci-calamares-config'
           'alci-calamares-config-dev'
           'alci-calamares-config-pure'
           'alci-calamares-config-btrfs')
source=('git+https://github.com/CatOS-dev/catos-calamares-config.git')
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}"

  if [[ -d etc ]]; then
    install -d "${pkgdir}/etc"
    cp -a etc/. "${pkgdir}/etc/"
  fi
  if [[ -d usr ]]; then
    install -d "${pkgdir}/usr"
    cp -a usr/. "${pkgdir}/usr/"
  fi
}
