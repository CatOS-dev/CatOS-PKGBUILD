# Maintainer: Aromatic <symwww@outlook.com>
pkgname=catos-hello
pkgver=0.1.2
pkgrel=1
pkgdesc='CatOS Hello welcome application'
arch=('x86_64')
url='https://github.com/CatOS-dev/catos-hello'
license=('GPL')
depends=('qt6-base' 'rate-mirrors' 'lshw' 'inxi' 'lsb-release')
makedepends=('git' 'cmake' 'gcc' 'make' 'qt6-tools' 'qt5-translations')
source=("${pkgname}::git+https://github.com/CatOS-dev/catos-hello.git")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
