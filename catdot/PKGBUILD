pkgname=catdot
pkgver=0.1.1
pkgrel=1
pkgdesc='CatOS complete configuration profile switcher'
arch=('x86_64')
url='https://github.com/CatOS-dev/catdot'
license=('GPL-3.0-or-later')
depends=(
  'pacman'
  'sudo'
)
makedepends=(
  'git'
  'rust'
)
source=('git+https://github.com/CatOS-dev/catdot.git')
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  CARGO_HOME="$srcdir/cargo-home" \
    cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "$srcdir/$pkgname"
  CARGO_HOME="$srcdir/cargo-home" \
  RUSTFLAGS="--remap-path-prefix=$srcdir=." \
    cargo build --release --frozen
}

package() {
  cd "$srcdir/$pkgname"
  sh packaging/install.sh "$PWD" "$pkgdir"
}
