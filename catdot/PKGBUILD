pkgname=catdot
pkgver=0.1.1
pkgrel=2
pkgdesc='CatOS complete configuration profile switcher'
arch=('x86_64')
url='https://github.com/CatOS-dev/catdot'
license=('GPL-3.0-or-later')
depends=(
  'pacman'
  'sudo'
)
makedepends=(
  'git'
  'rust'
)
source=('git+https://github.com/CatOS-dev/catdot.git' 'catdot-vendor.tar.zst')
sha256sums=('SKIP' '02f2e69cf13f94b4f74f1cca6f20f0f4a585e98334299b7c951bc521e8685a51')

prepare() {
  cd "$srcdir/$pkgname"
  mkdir -p .cargo
  cat > .cargo/config.toml <<EOF
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "$srcdir/catdot-vendor"
EOF
}

build() {
  cd "$srcdir/$pkgname"
  CARGO_HOME="$srcdir/cargo-home" \
  CARGO_NET_OFFLINE=true \
  RUSTFLAGS="--remap-path-prefix=$srcdir=." \
    cargo build --release --frozen
}

package() {
  cd "$srcdir/$pkgname"
  sh packaging/install.sh "$PWD" "$pkgdir"
}
