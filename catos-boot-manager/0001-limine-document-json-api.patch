+fn append_json_children(
+    nodes: &[Node],
+    prefix: &str,
+    default_prefix: &str,
+    occurrences: &mut BTreeMap<String, usize>,
+    output: &mut String,
+) {
+    let mut siblings = BTreeMap::<String, usize>::new();
+    for (index, node) in nodes.iter().enumerate() {
+        if index > 0 {
+            output.push(',');
+        }
+        let name = &node.clean_name;
+        let path = if prefix.is_empty() {
+            name.clone()
+        } else {
+            format!("{prefix}/{name}")
+        };
+        let position = occurrences
+            .entry(path.clone())
+            .and_modify(|count| *count += 1)
+            .or_insert(1);
+        let sibling = siblings
+            .entry(name.clone())
+            .and_modify(|n| *n += 1)
+            .or_insert(1);
+        let mut escaped = String::new();
+        for ch in name.chars() {
+            if matches!(ch, '/' | '\\' | '#') {
+                escaped.push('\\');
+            }
+            escaped.push(ch);
+        }
+        if *sibling > 1 {
+            escaped.push_str(&format!("#{}", *sibling - 1));
+        }
+        let selection = if default_prefix.is_empty() {
+            escaped
+        } else {
+            format!("{default_prefix}/{escaped}")
+        };
+        output.push_str("{\"name\":");
+        append_json_string(name, output);
+        output.push_str(",\"path\":");
+        append_json_string(&path, output);
+        output.push_str(",\"selection\":");
+        append_json_string(&selection, output);
+        output.push_str(&format!(",\"position\":{position},\"lines\":["));
+        for (line_index, line) in node.config_lines.iter().enumerate() {
+            if line_index > 0 {
+                output.push(',');
+            }
+            append_json_string(line, output);
+        }
+        output.push_str("],\"children\":[");
+        append_json_children(&node.children, &path, &selection, occurrences, output);
+        output.push_str("]}");
+    }
+}
+
+pub(crate) fn append_json_string(value: &str, output: &mut String) {
+    output.push('"');
+    for ch in value.chars() {
+        match ch {
+            '"' => output.push_str("\\\""),
+            '\\' => output.push_str("\\\\"),
+            '\n' => output.push_str("\\n"),
+            '\r' => output.push_str("\\r"),
+            '\t' => output.push_str("\\t"),
+            ch if ch < '\u{20}' => output.push_str(&format!("\\u{:04x}", ch as u32)),
+            ch => output.push(ch),
+        }
+    }
+    output.push('"');
+}
