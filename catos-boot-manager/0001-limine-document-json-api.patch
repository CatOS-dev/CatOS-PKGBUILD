+    /// Read-only JSON menu view for graphical clients. Each entry includes a
+    /// display name and a remove-entry-compatible path and occurrence index.
+    pub fn tree_json(&self) -> String {
+        let mut json = String::from("{\"globals\":{");
+        let mut globals = BTreeMap::<String, String>::new();
+        for line in &self.root.config_lines {
+            if let Some((key, value)) = line.split_once(':') {
+                let key = key.trim().to_ascii_lowercase();
+                if !key.is_empty() && !key.starts_with('#') {
+                    globals.insert(key, value.trim().to_owned());
+                }
+            }
+        }
+        for (index, (key, value)) in globals.iter().enumerate() {
+            if index > 0 {
+                json.push(',');
+            }
+            append_json_string(key, &mut json);
+            json.push(':');
+            append_json_string(value, &mut json);
+        }
+        json.push_str("},\"entries\":[");
+        let mut occurrences = BTreeMap::new();
+        append_json_children(&self.root.children, "", "", &mut occurrences, &mut json);
+        json.push_str("]}");
+        json
+    }
+
+    pub fn set_global_option(&mut self, key: &str, value: &str) -> bool {
+        let replacement = format!("{key}: {value}");
+        let mut first = None;
+        let mut duplicates = Vec::new();
+        for (index, line) in self.root.config_lines.iter().enumerate() {
+            if line.trim_start().starts_with('#') {
+                continue;
+            }
+            if let Some((name, _)) = line.split_once(':') {
+                if name.trim().eq_ignore_ascii_case(key) {
+                    if first.is_none() {
+                        first = Some(index);
+                    } else {
+                        duplicates.push(index);
+                    }
+                }
+            }
+        }
+        if let Some(index) = first {
+            if duplicates.is_empty() && self.root.config_lines[index] == replacement {
+                return false;
+            }
+            self.root.config_lines[index] = replacement;
+            for index in duplicates.into_iter().rev() {
+                self.root.config_lines.remove(index);
+            }
+        } else {
+            self.root.config_lines.push(replacement);
+        }
+        true
+    }
