pkgname=catos-sddm-theme
pkgver=1.0
pkgrel=2
pkgdesc="CatOS configuration of the Corners SDDM theme"
arch=('any')
url='https://github.com/aczw/sddm-theme-corners'
license=('GPL3')
depends=('sddm' 'qt5-graphicaleffects' 'qt5-svg' 'qt5-quickcontrols2' 'catos-branding')
makedepends=('git')
backup=('etc/sddm.conf.d/catos-theme.conf'
        'usr/share/sddm/themes/corners/theme.conf')
source=('https://bdd.invalid/sddm-theme-corners.git')
sha256sums=('SKIP')

package() {
  cd "${srcdir}/sddm-theme-corners"

  install -d "${pkgdir}/usr/share/sddm/themes"
  cp -a corners "${pkgdir}/usr/share/sddm/themes/"
  install -Dm644 /dev/stdin "${pkgdir}/etc/sddm.conf.d/catos-theme.conf" <<'CONFIG'
[Theme]
Current=corners
CONFIG
}
