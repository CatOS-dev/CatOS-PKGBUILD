[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/pkgbase
Target = usr/lib/modules/*/updates/*
Target = usr/lib/modules/*/extramodules/*
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/boot/efi/*.efi
Target = usr/share/limine/*.EFI
Target = usr/lib/grub/*

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = grub
Target = systemd
Target = limine
Target = nvidia
Target = nvidia-open
Target = nvidia-dkms
Target = broadcom-wl
Target = broadcom-wl-dkms

[Action]
Description = Maintaining CatOS Secure Boot signatures...
When = PostTransaction
Exec = /usr/bin/catos-secureboot maintain --hook
