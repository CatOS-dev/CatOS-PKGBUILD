[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/pkgbase
Target = usr/lib/modules/*/updates/*
Target = usr/lib/modules/*/extramodules/*
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/boot/efi/*.efi
Target = usr/share/limine/*.EFI
Target = usr/lib/grub/*

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub
Target = systemd
Target = limine
Target = limine-tool

[Action]
Description = Signing final CatOS EFI boot chain...
When = PostTransaction
Exec = /usr/bin/catos-secureboot finalize-efi --hook
