# CatOS native package based on upstream's Arch PKGBUILD.
# Deliberately does not replace global MIME handlers or XDG portal defaults.
pkgname=serpantinum
pkgver=2.5.1
pkgrel=1
pkgdesc='Wayland desktop Shell powered by Quickshell'
arch=('x86_64')
url='https://github.com/ilyamiro/serpantinum'
license=('AGPL-3.0-or-later')
depends=(
  'kitty' 'cava' 'zbar' 'tesseract' 'tesseract-data-eng' 'pavucontrol'
  'alsa-utils' 'wl-clipboard' 'fd' 'qt6-multimedia' 'ripgrep'
  'cliphist' 'jq' 'socat' 'inotify-tools' 'pamixer' 'brightnessctl'
  'ddcutil' 'acpi' 'iw' 'bluez' 'bluez-utils' 'libnotify' 'networkmanager'
  'lm_sensors' 'bc' 'matugen' 'pipewire' 'wireplumber' 'pipewire-pulse'
  'pipewire-alsa' 'libpulse' 'python' 'imagemagick' 'wget' 'file'
  'git' 'psmisc' 'ffmpeg' 'fastfetch' 'quickshell' 'unzip'
  'python-websockets' 'python-jeepney' 'qt6-websockets' 'grim'
  'playerctl' 'satty' 'xdg-desktop-portal-gtk' 'slurp' 'wmctrl'
  'power-profiles-daemon' 'qt6-wayland' 'qt6ct' 'adwaita-icon-theme'
  'gpu-screen-recorder' 'wf-recorder' 'adw-gtk-theme'
  'ttf-iosevka-nerd' 'pambase' 'curl' 'pciutils'
)
optdepends=(
  'hyprland: Hyprland compositor'
  'niri: Niri compositor'
  'sway: Sway compositor'
  'mangowm: Mango compositor'
  'sddm: Optional login screen theme'
  'qt6-declarative: Optional login screen theme'
  'qt6-svg: Optional login screen theme'
)
conflicts=('quickshell-git')
backup=('etc/pam.d/serpantinum')
install=serpantinum.install

_skiver=0.6.3
_audiover=0.4.0
_gammaver=0.7.0
_corever=0.6.0
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "ski-$_skiver-x86_64-linux.tar.gz::https://github.com/ilyamiro/Ski/releases/download/v$_skiver/ski-$_skiver-x86_64-linux.tar.gz"
  "serpantinum-audio-$_audiover-x86_64-linux.tar.gz::https://github.com/ilyamiro/serpantinum-audio/releases/download/v$_audiover/serpantinum-audio-$_audiover-x86_64-linux.tar.gz"
  "serpantinum-gamma-$_gammaver-x86_64-linux.tar.gz::https://github.com/ilyamiro/serpantinum-gamma/releases/download/v$_gammaver/serpantinum-gamma-$_gammaver-x86_64-linux.tar.gz"
  "serpantinum-core-$_corever-x86_64-linux.tar.gz::https://github.com/ilyamiro/serpantinum-core/releases/download/v$_corever/serpantinum-core-$_corever-x86_64-linux.tar.gz"
)
sha256sums=(
  '46696553a4b274e886ccbae99e074d605a6ab8bbd82c41ca762e46256f8cb031'
  '821391cf6a4eb3130bea7d6494c25165a665a9da7e549fba5d0e9cf330a92f95'
  '8c1ac960b3bf6a6f06ac9d0ffb6a7a92ef32b06be7aec28de5d915db6b46f28d'
  '942ba54eab4ad7fdce634e61b6c212bbfc14c2771115f4f1b2d370f32646ae04'
  '92b7a0ce0eb4a90e1cdc96a9a275716dd331776f7b2f4dd5b090c8a4f18ff974'
)

package() {
  cd "$pkgname-$pkgver"

  local share="$pkgdir/usr/share/serpantinum"

  install -d "$share"
  cp -a bin src config compositors "$share/"
  install -Dm644 version.txt "$share/version.txt"
  printf 'pacman\n' | install -Dm644 /dev/stdin "$share/package-managed"

  chmod 755 "$share"/bin/*
  find "$share/src" -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod 755 {} +

  install -d "$pkgdir/usr/bin"
  ln -s ../share/serpantinum/bin/serpantinum "$pkgdir/usr/bin/serpantinum"
  ln -s ../share/serpantinum/bin/serpantinumd "$pkgdir/usr/bin/serpantinumd"

  # Theme files are installed but never activated system-wide by the package.
  install -d "$pkgdir/usr/share/sddm/themes"
  mv "$share/config/sddm/themes/material-you" "$pkgdir/usr/share/sddm/themes/material-you"
  rmdir -p --ignore-fail-on-non-empty "$share/config/sddm/themes"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/sddm/themes/material-you"

  # Dedicated PAM service for Serpantinum's own lock screen.
  install -Dm644 /dev/stdin "$pkgdir/etc/pam.d/serpantinum" <<'EOF'
-auth       sufficient   pam_fprintd.so
auth        include      system-auth
account     include      system-auth
EOF

  # The release archives place their helper executables under usr/.
  cp -a "$srcdir/usr/." "$pkgdir/usr/"

  # Nautilus already owns this standard D-Bus activator. Shipping two
  # owners makes the Niri Serpantinum profile uninstallable.
  rm -- "$pkgdir/usr/share/dbus-1/services/org.freedesktop.FileManager1.service"

  # Unlike upstream's AUR package, do not set global portal, MIME
  # application, or environment defaults. Catdot owns user-local settings.
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
