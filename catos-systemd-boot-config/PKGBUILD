pkgname=catos-systemd-boot-config
pkgver=0.1.0
pkgrel=3
pkgdesc="Pacman hooks for kernel-install and systemd-boot."
url='https://man.archlinux.org/man/kernel-install.8'
arch=('any')
license=('GPL')
depends=('bash' 'systemd' 'util-linux')
source=(
	'90-kernel-install-add.hook'
	'40-kernel-install-remove.hook'
	'kernel-install.sh'
	'95-systemd-boot.hook'
	'systemd-boot-update.sh'
	'10-catos-systemd-boot.conf'
)

package() {
	install -Dm644 '90-kernel-install-add.hook' '40-kernel-install-remove.hook' \
		'95-systemd-boot.hook' -t "${pkgdir}/usr/share/libalpm/hooks"
	install -Dm755 'kernel-install.sh' \
		"${pkgdir}/usr/share/libalpm/scripts/kernel-install"
	install -Dm755 'systemd-boot-update.sh' \
		"${pkgdir}/usr/share/libalpm/scripts/systemd-boot-update"
	install -Dm644 '10-catos-systemd-boot.conf' \
		"${pkgdir}/usr/lib/kernel/install.conf.d/10-catos-systemd-boot.conf"
}

sha256sums=('965bbe969ab1baf162d08ff7225163c1a0b0e9a120e818647b247078cc07b331'
